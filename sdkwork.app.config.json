{
  "schemaVersion": 3,
  "kind": "sdkwork.app",
  "app": {
    "key": "sdkwork-inventory",
    "name": "Inventory",
    "displayName": "SDKWork Inventory",
    "description": "SDKWork Inventory application (bootstrap deploy layout).",
    "appType": "SDK"
  },
  "backend": {
    "primaryLanguage": "rust",
    "framework": "axum",
    "appId": "sdkwork-inventory",
    "serviceId": "sdkwork-inventory",
    "owner": "sdkwork-inventory",
    "domain": "inventory"
  },
  "runtime": {
    "family": "server",
    "framework": "rust-axum",
    "supportedDeploymentProfiles": [
      "standalone",
      "cloud"
    ],
    "defaultDeploymentProfile": "standalone"
  }
}
